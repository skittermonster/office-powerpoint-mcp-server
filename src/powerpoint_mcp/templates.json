  "templates": {
    "title_slide": {
      "name": "Title Slide",
      "description": "Clean, authoritative title slide with title, subtitle, author/organization, and accent line",
      "layout_index": 6,
      "elements": [
        {
          "role": "decorative_bar",
          "type": "shape",
          "shape_type": "rectangle",
          "position": {"left": 1.5, "top": 2.0, "width": 1.2, "height": 0.08},
          "styling": {"fill_role": "primary", "border": false}
        },
        {
          "role": "title",
          "type": "text",
          "position": {"left": 1.5, "top": 2.3, "width": 10.333, "height": 1.8},
          "styling": {
            "font_role": "title",
            "font_size": 40,
            "bold": true,
            "color_role": "primary",
            "alignment": "left"
          }
        },
        {
          "role": "subtitle",
          "type": "text",
          "position": {"left": 1.5, "top": 4.2, "width": 10.333, "height": 1.0},
          "styling": {
            "font_role": "body",
            "font_size": 20,
            "bold": false,
            "color_role": "muted_text",
            "alignment": "left"
          }
        },
        {
          "role": "author",
          "type": "text",
          "position": {"left": 1.5, "top": 5.5, "width": 10.333, "height": 0.8},
          "styling": {
            "font_role": "body",
            "font_size": 13,
            "bold": true,
            "color_role": "secondary",
            "alignment": "left"
          }
        }
      ]
    },
    "executive_summary": {
      "name": "Executive Summary",
      "description": "Two structured strategic cards for context, key takeaways, and strategic implications",
      "layout_index": 6,
      "header": {
        "title_position": {"left": 1.0, "top": 0.6, "width": 11.333, "height": 0.8},
        "subtitle_position": {"left": 1.0, "top": 1.4, "width": 11.333, "height": 0.5}
      },
      "cards": [
        {
          "name": "card_left",
          "role": "key_takeaways",
          "position": {"left": 1.0, "top": 2.1, "width": 5.45, "height": 4.7},
          "title_default": "Key Observations & Findings",
          "styling": {"fill_role": "light", "border_role": "border"}
        },
        {
          "name": "card_right",
          "role": "recommendations",
          "position": {"left": 6.883, "top": 2.1, "width": 5.45, "height": 4.7},
          "title_default": "Strategic Recommendations",
          "styling": {"fill_role": "light", "border_role": "border"}
        }
      ]
    },
    "two_column_comparison": {
      "name": "Two-Column Comparison",
      "description": "Side-by-side comparison cards for options, competitors, or pros vs cons",
      "layout_index": 6,
      "header": {
        "title_position": {"left": 1.0, "top": 0.6, "width": 11.333, "height": 0.8},
        "subtitle_position": {"left": 1.0, "top": 1.4, "width": 11.333, "height": 0.5}
      },
      "cards": [
        {
          "name": "col_1",
          "position": {"left": 1.0, "top": 2.1, "width": 5.45, "height": 4.7},
          "title_default": "Option A / Current State",
          "styling": {"fill_role": "light", "border_role": "border"}
        },
        {
          "name": "col_2",
          "position": {"left": 6.883, "top": 2.1, "width": 5.45, "height": 4.7},
          "title_default": "Option B / Target State",
          "styling": {"fill_role": "light", "border_role": "border"}
        }
      ]
    },
    "kpi_metrics_grid": {
      "name": "KPI Metrics Grid",
